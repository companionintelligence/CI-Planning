<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple Privacy Manifest for the app target. Capacitor and its plugins ship framework
  manifests; this one covers the app bundle. The Filesystem plugin reads file timestamps
  for files managed inside the app container, declared below with Apple's C617.1 reason.

  NSPrivacyCollectedDataTypes is empty on purpose. Companion Planning is a client for a
  server the person runs; what they enter is sent only to that server, which Lifescope has
  no access to, so under Apple's access-based definition the developer collects nothing.
  The App Store Connect "App Privacy" label is a separate artifact and the owner's to
  answer; keep the two in step. A demo server run by Lifescope for App Review would change
  this: data sent to it is developer-accessible and must then be declared here and on the
  label. The bundle makes no third-party requests: the Manrope font ships inside it
  (client/src/main.tsx).

  Tracking: none. No ads, no analytics SDK, no cross-app identifiers. The client reports
  errors only if VITE_SENTRY_DSN was baked in at build time, and the mobile build sets none.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
