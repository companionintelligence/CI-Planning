<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.companion-planning.server</string>

  <key>ProgramArguments</key>
  <!-- The server runs via tsx (there is no dist/ build step). Keep the explicit
       node path so launchd's minimal PATH still finds it, and load tsx in-process
       via node's import flag (the two args below) so node stays the tracked
       process and SIGTERM reaches the graceful-shutdown handler in src/index.ts.
       The server binds all interfaces by default, so no host argument is needed. -->
  <array>
    <string>/usr/local/bin/node</string>
    <string>--import</string>
    <string>tsx</string>
    <string>REPO_PATH/server/src/index.ts</string>
  </array>

  <!-- server package dir: tsx resolves from server/node_modules and matches the
       Dockerfile's WORKDIR. Server startup is cwd-independent (DB path + config
       come from env/homedir), so this only affects module resolution. -->
  <key>WorkingDirectory</key>
  <string>REPO_PATH/server</string>

  <!-- Personal single-user install (Tailscale laptop): deliberately NO
       NODE_ENV=production here — the production fail-closed guards forbid the
       credential-free AUTH_MODE=test default, so with it set and no AUTH_MODE the
       server exits at boot and KeepAlive crash-loops it every 10s. For a hardened
       deployment, add an EnvironmentVariables dict with NODE_ENV=production AND a
       real auth mode (AUTH_MODE=sso + SESSION_SECRET + DISABLE_OIDC=true +
       AUTH_DEFAULT_USERNAME/AUTH_DEFAULT_PASSWORD), per README "First run". -->

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPO_PATH/logs/server.log</string>

  <key>StandardErrorPath</key>
  <string>REPO_PATH/logs/server.error.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
