<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.companion-planning.summary.daily</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPO_PATH/ops/scripts/summary.sh</string>
    <string>daily</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <!-- Every day at 21:00 local -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>21</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>REPO_PATH/logs/summary.daily.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PATH/logs/summary.daily.error.log</string>
</dict>
</plist>
