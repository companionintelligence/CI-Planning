<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.companion-planning.summary.weekly</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPO_PATH/ops/scripts/summary.sh</string>
    <string>weekly</string>
  </array>

  <key>WorkingDirectory</key>
  <string>REPO_PATH</string>

  <!-- Sundays at 19:00 local (Weekday 0 = Sunday) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>REPO_PATH/logs/summary.weekly.log</string>
  <key>StandardErrorPath</key>
  <string>REPO_PATH/logs/summary.weekly.error.log</string>
</dict>
</plist>
