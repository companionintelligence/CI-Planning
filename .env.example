# Environment for the standalone docker-compose stack (docker-compose.yml).
# Copy to `.env` and fill in — `docker compose up` reads it automatically.
# This is for the self-host path only; the CI-Hub marketplace install ignores it.

# Signs the login session cookie. Generate a strong random value:
#   openssl rand -hex 32
SESSION_SECRET=

# First-owner login, seeded as operator on first boot (fail-closed: the app refuses
# to start without a login path).
AUTH_DEFAULT_USERNAME=you
AUTH_DEFAULT_PASSWORD=pick-a-strong-password

# IANA timezone for the container clock (drives "today" for the planner + nightly jobs).
TZ=America/Los_Angeles

# ── Error reporting (Sentry) — opt-OUT: ON once a DSN is set ─────────────────
# Set SENTRY_DSN and the app reports crashes by default; the kill switches below
# turn it back off. Leave every line commented — as in this source checkout —
# and nothing initialises: the app opens no connection to Sentry at all. That is
# the absence of configuration, not a privacy setting.
# See docs/operations/error-reporting.md.
#
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<id>
# SENTRY_ENV=production          # else CI_PLANNING_ENVIRONMENT, else NODE_ENV
# CI_PLANNING_VERSION=0.3.0      # release becomes ci-planning-server@0.3.0
#
# Kill switches — both beat a DSN, so an operator can disable reporting that was
# baked into an image without rebuilding it. CI_LOCAL_ONLY wins over CI_TELEMETRY.
# They cover the BROWSER as well as the server: the bundle asks the server
# (GET /api/config/telemetry) whether reporting is permitted before it initialises.
# CI_TELEMETRY=off               # off | false | 0 | no | disabled
# CI_LOCAL_ONLY=true             # local-only mode ⇒ zero phone-home
#
# The browser's DSN, by contrast, is baked in at BUILD time (Vite inlines it), so it is
# a docker build arg rather than a runtime variable and setting it here does nothing.
# See the Dockerfile's ARG VITE_SENTRY_DSN.
