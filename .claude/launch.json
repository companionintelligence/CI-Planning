{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "All (server + client)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "Koa API server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "server", "start"],
      "port": 3848
    },
    {
      "name": "Vite client dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "client", "dev"],
      "port": 5173
    }
  ]
}
