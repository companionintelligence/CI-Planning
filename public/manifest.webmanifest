{
  "name": "Companion Planning",
  "short_name": "Companion",
  "description": "Private, local-first, MCP-native personal todo app",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "theme_color": "#0f1115",
  "background_color": "#0f1115",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today",     "short_name": "Today",     "url": "/#today",  "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "All todos", "short_name": "Todos",     "url": "/#todos",  "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search",    "short_name": "Search",    "url": "/#search", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
