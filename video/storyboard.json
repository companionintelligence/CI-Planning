          "pointer": {
            "landscape": {
              "x": 0.728,
              "y": 0.294
            },
            "portrait": {
              "x": 0.848,
              "y": 0.33
            }
          },
          "capture": {
            "path": "/focus",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:has-text(\"Focus\")",
            "settle": 1000,
            "mask": [
              "div.h-1.rounded-full"
            ]
          }
        }
      ]
    },
    {
      "id": "plan-the-week",
      "kind": "screen",
      "chapter": "week",
      "seconds": 5,
      "transition": "cut",
      "caption": "Three ways to plan the week. None of them need a model.",
      "narration": "Planning the week is three choices. None of them need a model.",
      "shots": [
        {
          "id": "plan-my-week",
          "url": "planning-living-room-server-acme.ci.computer/calendar",
          "alt": "The Plan my week dialog: Fill next week — deterministic, no AI; Schedule tasks — one at a time, no AI; Review past data — read-only.",
          "motion": "pull-back",
          "capture": {
            "path": "/calendar",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Calendar\")",
            "before": [
              {
                "click": "button:has-text(\"Plan my week\")"
              },
              {
                "waitFor": ".modal p:text-is(\"What would you like to do?\")"
              }
            ],
            "settle": 800
          },
          "focus": {
            "landscape": {
              "x": 0.2,
              "y": 0.215,
              "w": 0.6,
              "h": 0.6
            },
            "portrait": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            }
          },
          "pointer": {
            "landscape": {
              "x": 0.4,
              "y": 0.442
            },
            "portrait": {
              "x": 0.145,
              "y": 0.719
            }
          }
        }
      ]
    },
    {
      "id": "the-week",
      "kind": "screen",
      "chapter": "week",
      "seconds": 4.5,
      "transition": "cut",
      "caption": "Meetings mirrored, and your own work placed around them.",
      "narration": "It places your work around the meetings you already have.",
      "shots": [
        {
          "id": "calendar-week",
          "url": "planning-living-room-server-acme.ci.computer/calendar",
          "alt": "The calendar grid scrolled to the middle of the working day: locked meeting mirrors with Wednesday's own task blocks placed into the gaps between them — the week Monday to Sunday on desktop, the single day on a phone.",
          "motion": "drift-down",
          "focus": {
            "landscape": {
              "x": 0.199,
              "y": 0.2,
              "w": 0.538,
              "h": 0.538
            },
            "portrait": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            }
          },
          "capture": {
            "path": "/calendar",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Calendar\")",
            "before": [
              {
                "eval": "async () => { const wide = window.innerWidth >= 700; const want = wide ? 'week' : 'day'; const b = [...document.querySelectorAll('button')].find((e) => e.textContent.trim().toLowerCase() === want); if (b) b.click(); }"
              },
              {
                "wait": 700
              },
              {
                "eval": "() => { const c = [...document.querySelectorAll('div.overflow-auto')].filter((e) => e.scrollHeight > e.clientHeight + 20).sort((a, b) => (b.scrollHeight - b.clientHeight) - (a.scrollHeight - a.clientHeight))[0]; if (c) c.scrollTop = Math.round(c.scrollHeight * 0.30); }"
              },
              {
                "wait": 400
              }
            ],
            "settle": 1000
          }
        }
      ]
    },
    {
      "id": "the-long-game",
      "kind": "screen",
      "chapter": "long",
      "seconds": 6,
      "transition": "hold",
      "caption": "Goals, projects, objectives — what the day is for.",
      "narration": "Above the day sit goals, projects and objectives, so a Tuesday has something to be for.",
      "shots": [
        {
          "id": "objectives-tree",
          "url": "planning-living-room-server-acme.ci.computer/tasks",
          "alt": "The Objectives tab: a goal, project and objective tree with progress rolled up from the tasks linked underneath.",
          "motion": "push-in",
          "focus": {
            "landscape": {
              "x": 0.128,
              "y": 0.112,
              "w": 0.576,
              "h": 0.576
            },
            "portrait": {
              "x": 0,
