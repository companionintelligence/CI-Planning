{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-planning",
    "name": "Companion Planning",
    "repo": "companionintelligence/CI-Planning",
    "marketplaceId": "ci-planning",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5,
    "pacing": "fit",
    "pacingTail": 0.2
  },
  "chapters": {
    "day": "One day",
    "week": "The week ahead",
    "long": "The long game",
    "yours": "What stays yours"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "what-it-knows",
      "kind": "feature",
      "seconds": 6.5,
      "reveal": "paced",
      "title": "What a planner knows",
      "caption": "The most personal file you keep.",
      "narration": "A planner knows when you sleep, which doctor you see, and who you met on Tuesday.",
      "items": [
        {
          "label": "Sleep",
          "value": "when you turn in"
        },
        {
          "label": "Health",
          "value": "every appointment"
        },
        {
          "label": "People",
          "value": "who you meet"
        }
      ]
    },
    {
      "id": "someone-elses-product",
      "kind": "feature",
      "seconds": 8,
      "reveal": "paced",
      "title": "Someone else's product",
      "caption": "You are a renting tenant.",
      "narration": "And it runs on their computer. Atlassian defaults Jira and Confluence customers into using their content to train its AI.",
      "items": [
        {
          "label": "Where it lives",
          "value": "Their database"
        },
        {
          "label": "Your access",
          "value": "Subject to their terms"
        }
      ],
      "transition": "hold"
    },
    {
      "id": "most-people-quit",
      "kind": "feature",
      "seconds": 7,
      "reveal": "paced",
      "transition": "hold",
      "title": "You could move it",
      "caption": "All of it. At once.",
      "narration": "Moving means moving all of it at once, into another company's database. Most people quit right about here.",
      "items": [
        {
          "label": "Every task",
          "value": "and its priority"
        },
        {
          "label": "Every event",
          "value": "and what it's for"
        },
        {
          "label": "Every hour",
          "value": "you already spent deciding"
        }
      ]
    },
    {
      "id": "title-card",
      "kind": "intro",
      "seconds": 7,
      "minSeconds": 5.5,
      "reveal": "paced",
      "transition": "hold",
      "title": "Companion Planning",
      "caption": "A planner that runs on your own machine.",
      "narration": "Companion Planning is the other way round. Your whole plan is one SQLite file you can copy and keep.",
      "mark": "./assets/app-icon.png"
    },
    {
      "id": "one-line-in",
      "kind": "screen",
      "chapter": "day",
      "seconds": 7,
      "transition": "cut",
      "caption": "One line in. Title, time and tag out — yours to approve.",
      "narration": "Type one line. It comes back as a title, a time and a tag, for you to approve.",
      "shots": [
        {
          "id": "add-element",
          "url": "planning-living-room-server-acme.ci.computer",
          "alt": "The add wizard with one natural-language line typed into it: \"pay invoice 3pm #work #invoices ~20m\".",
          "motion": "push-in",
          "focus": {
            "landscape": {
              "x": 0.285,
              "y": 0.085,
              "w": 0.43,
              "h": 0.8
            },
            "portrait": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            }
          },
          "capture": {
            "path": "/",
            "waitUntil": "domcontentloaded",
            "waitFor": "button.fab",
            "before": [
              {
                "click": "button.fab"
              },
              {
                "waitFor": ".modal input[placeholder^=\"Describe it\"]"
              },
              {
                "fill": [
                  ".modal input[placeholder^=\"Describe it\"]",
                  "pay invoice 3pm #work #invoices ~20m"
                ]
              }
            ],
            "settle": 600
          }
        },
        {
          "id": "add-element-parsed",
          "url": "planning-living-room-server-acme.ci.computer",
          "alt": "The same wizard after parsing: title, time, duration and an intention tag, all still editable.",
          "motion": "push-in",
          "focus": {
            "landscape": {
              "x": 0.285,
              "y": 0.1,
              "w": 0.43,
              "h": 0.8
            },
            "portrait": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            }
          },
          "capture": {
            "path": "/",
            "waitUntil": "domcontentloaded",
            "waitFor": "button.fab",
            "before": [
              {
                "click": "button.fab"
              },
              {
                "waitFor": ".modal input[placeholder^=\"Describe it\"]"
              },
              {
                "fill": [
                  ".modal input[placeholder^=\"Describe it\"]",
                  "pay invoice 3pm #work #invoices ~20m"
                ]
              },
              {
                "press": [
                  ".modal input[placeholder^=\"Describe it\"]",
                  "Enter"
                ]
              },
              {
                "waitFor": ".modal span.rounded-full:has-text(\"invoices\")"
              }
            ],
            "settle": 800
          }
        }
      ]
    },
    {
      "id": "today-cockpit",
      "kind": "screen",
      "chapter": "day",
      "seconds": 5,
      "transition": "cut",
      "caption": "24 staged. 10h 15m of work, against a 9-hour day.",
      "narration": "Today is the cockpit. Twenty-four things staged, and it tells you they don't fit.",
      "shots": [
        {
          "id": "today-cockpit",
          "url": "planning-living-room-server-acme.ci.computer",
          "alt": "The Today screen: the day header reading 10h 15m against a 9-hour day in red, above a flight plan of twenty-four staged tasks with the minutes each one will cost.",
          "motion": "drift-down",
          "focus": {
            "landscape": {
              "x": 0.136,
              "y": 0.083,
              "w": 0.656,
              "h": 0.538
            },
            "portrait": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            }
          },
          "capture": {
            "path": "/",
            "waitUntil": "domcontentloaded",
            "waitFor": "span:text-is(\"Planner\")",
            "settle": 1200,
            "mask": [
              "span.bg-destructive",
              ".bg-ring"
            ]
          }
        }
      ]
    },
    {
      "id": "focus-now",
      "kind": "screen",
      "chapter": "day",
      "seconds": 4.5,
      "transition": "cut",
      "caption": "Focus: today in time order, one Start at a time.",
      "narration": "Focus strips the day to one list, in order, with one thing to start.",
      "shots": [
        {
          "id": "focus-now",
          "url": "planning-living-room-server-acme.ci.computer/focus",
          "alt": "The Focus screen: today's placed work as a single time-ordered list, each row with its own Start.",
          "motion": "push-in",
          "focus": {
            "landscape": {
              "x": 0.27,
              "y": 0.08,
              "w": 0.56,
              "h": 0.56
            }
