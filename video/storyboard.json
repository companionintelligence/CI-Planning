{
  "$schema": "https://raw.githubusercontent.com/companionintelligence/CI-Common/main/packages/video-kit/schema/storyboard.schema.json",
  "app": {
    "id": "ci-planning",
    "name": "Companion Planning",
    "repo": "companionintelligence/CI-Planning",
    "marketplaceId": "ci-planning",
    "website": "ci.computer"
  },
  "meta": {
    "fps": 30,
    "transitionSeconds": 0.5,
    "pacing": "fit"
  },
  "chapters": {
    "setup": "First run",
    "day": "Your day",
    "plan": "The long game"
  },
  "media": {
    "music": null,
    "musicVolume": 0.14
  },
  "scenes": [
    {
      "id": "open",
      "kind": "intro",
      "seconds": 5,
      "title": "Companion Planning",
      "caption": "A planner that runs on your own machine.",
      "narration": "Companion Planning. A planner that runs on your machine, not the cloud.",
      "mark": "./assets/app-icon.png"
    },
    {
      "id": "ftue-time-place",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5,
      "caption": "First run: five skippable questions. Wake and bed first.",
      "narration": "Wake and bed times. The planner folds the hours outside them away.",
      "shots": [
        {
          "id": "ftue-time-place",
          "url": "planning.local",
          "alt": "Step two: timezone, wake and bed times, workday bounds.",
          "motion": "drift-down",
          "capture": {
            "path": "/?ftue=1",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Welcome\")",
            "before": [
              {
                "click": "button:text-is(\"Next\")"
              },
              {
                "waitFor": "h2:text-is(\"Time and place\")"
              }
            ],
            "settle": 600
          },
          "focus": {
            "landscape": {
              "x": 0.22,
              "y": 0.22,
              "w": 0.56,
              "h": 0.56
            }
          }
        }
      ]
    },
    {
      "id": "ftue-connect-source",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 6,
      "caption": "Point it at Gmail and Google Calendar. It syncs on your box.",
      "narration": "Gmail and Google Calendar, pulled on your own machine — not on someone else's.",
      "shots": [
        {
          "id": "ftue-connect-source",
          "url": "planning.local",
          "alt": "Step three: connect a mail and calendar source.",
          "motion": "push-in",
          "capture": {
            "path": "/?ftue=1",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Welcome\")",
            "before": [
              {
                "click": "button:text-is(\"Next\")"
              },
              {
                "waitFor": "h2:text-is(\"Time and place\")"
              },
              {
                "click": "button:text-is(\"Next\")"
              },
              {
                "waitFor": "h2:text-is(\"Connect a source\")"
              }
            ],
            "settle": 600
          },
          "focus": {
            "landscape": {
              "x": 0.22,
              "y": 0.22,
              "w": 0.56,
              "h": 0.56
            }
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "ftue-trust-dial",
      "kind": "screen",
      "chapter": "setup",
      "seconds": 5,
      "caption": "Cautious, balanced, hands-off. You set the dial.",
      "narration": "Then the trust dial — how much it may do unasked.",
      "shots": [
        {
          "id": "ftue-trust-dial",
          "url": "planning.local",
          "alt": "Step four: the trust dial, three options.",
          "motion": "push-in",
          "capture": {
            "path": "/?ftue=1",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Welcome\")",
            "before": [
              {
                "click": "button:text-is(\"Next\")"
              },
              {
                "waitFor": "h2:text-is(\"Time and place\")"
              },
              {
                "click": "button:text-is(\"Next\")"
              },
              {
                "waitFor": "h2:text-is(\"Connect a source\")"
              },
              {
                "click": "button:text-is(\"Next\")"
              },
              {
                "waitFor": "h2:text-is(\"Trust dial\")"
              }
            ],
            "settle": 600
          },
          "focus": {
            "landscape": {
              "x": 0.22,
              "y": 0.22,
              "w": 0.56,
              "h": 0.56
            }
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "today-cockpit",
      "kind": "screen",
      "chapter": "day",
      "seconds": 7.5,
      "caption": "Today: everything staged for the day, in priority order.",
      "narration": "Today is the cockpit. Staged work up top, the placed day underneath.",
      "shots": [
        {
          "id": "today-cockpit",
          "url": "planning.local",
          "alt": "The Today screen: day stars, flight plan, and the planner grid.",
          "motion": "drift-down",
          "capture": {
            "path": "/",
            "waitUntil": "domcontentloaded",
            "waitFor": "span:text-is(\"Planner\")",
            "settle": 1200,
            "mask": [
              "span.bg-destructive",
              ".bg-ring"
            ]
          }
        }
      ],
      "transition": "hold"
    },
    {
      "id": "add-anything",
      "kind": "screen",
      "chapter": "day",
      "seconds": 8,
      "caption": "One line in. Title, time and tag out — approve before it saves.",
      "narration": "Type one line. It becomes a title, a time and a tag, waiting for your approval.",
      "shots": [
        {
          "id": "add-element",
          "url": "planning.local",
          "alt": "The add wizard, with a natural-language line typed into it.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitUntil": "domcontentloaded",
            "waitFor": "button.fab",
            "before": [
              {
                "click": "button.fab"
              },
              {
                "waitFor": ".modal input[placeholder^=\"Describe it\"]"
              },
              {
                "fill": [
                  ".modal input[placeholder^=\"Describe it\"]",
                  "pay invoice 3pm #work #invoices ~20m"
                ]
              }
            ],
            "settle": 600
          }
        },
        {
          "id": "add-element-parsed",
          "url": "planning.local",
          "alt": "The add wizard after parsing: title, time, duration and an intention tag, all still editable.",
          "motion": "push-in",
          "capture": {
            "path": "/",
            "waitUntil": "domcontentloaded",
            "waitFor": "button.fab",
            "before": [
              {
                "click": "button.fab"
              },
              {
                "waitFor": ".modal input[placeholder^=\"Describe it\"]"
              },
              {
                "fill": [
                  ".modal input[placeholder^=\"Describe it\"]",
                  "pay invoice 3pm #work #invoices ~20m"
                ]
              },
              {
                "press": [
                  ".modal input[placeholder^=\"Describe it\"]",
                  "Enter"
                ]
              },
              {
                "waitFor": ".modal span.rounded-full:has-text(\"invoices\")"
              }
            ],
            "settle": 800
          }
        }
      ]
    },
    {
      "id": "focus-now",
      "kind": "screen",
      "chapter": "day",
      "seconds": 4.5,
      "caption": "Focus: one list, and the block you are in.",
      "narration": "Focus strips it to one list and the block you're in.",
      "shots": [
        {
          "id": "focus-now",
          "url": "planning.local/focus",
          "alt": "The Focus screen with the current block and its time-sense bar.",
          "motion": "push-in",
          "capture": {
            "path": "/focus",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:has-text(\"Focus\")",
            "settle": 1000,
            "mask": [
              "div.h-1.rounded-full"
            ]
          }
        }
      ]
    },
    {
      "id": "calendar-week",
      "kind": "screen",
      "chapter": "day",
      "seconds": 5,
      "caption": "The same day, widened to a week and a month.",
      "narration": "The calendar carries that day out to a week and a month.",
      "shots": [
        {
          "id": "calendar-week",
          "url": "planning.local/calendar",
          "alt": "The calendar week grid from the top of the working day: the day-name header row, meeting mirrors and auto-placed task blocks across Monday to Friday.",
          "motion": "drift-down",
          "capture": {
            "path": "/calendar",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Calendar\")",
            "before": [
              {
                "click": "button:text-is(\"week\")"
              },
              {
                "wait": 500
              }
            ],
            "settle": 1000
          }
        }
      ]
    },
    {
      "id": "calendar-month",
      "kind": "screen",
      "chapter": "day",
      "seconds": 5.5,
      "caption": "A month at a glance — this week placed, the rest still open.",
      "narration": "Zoom out to the month: this week placed, and the rest of it still open.",
      "shots": [
        {
          "id": "calendar-month",
          "url": "planning.local/calendar",
          "alt": "The calendar month grid: six weeks of cells, this week carrying its event chips, today marked by a filled accent pill on its date number.",
          "motion": "drift-down",
          "capture": {
            "path": "/calendar",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Calendar\")",
            "before": [
              {
                "click": "button:text-is(\"month\")"
              },
              {
                "waitFor": "div.grid-cols-7"
              },
              {
                "wait": 500
              }
            ],
            "settle": 1000
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "plan-my-week",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 5.5,
      "caption": "Three ways to plan the week. None of them need a model.",
      "narration": "Plan the week ahead in three moves; none of them need a model installed.",
      "shots": [
        {
          "id": "plan-my-week",
          "url": "planning.local/calendar",
          "alt": "The weekly planning assistant: fill next week, schedule tasks, or review past data.",
          "motion": "push-in",
          "capture": {
            "path": "/calendar",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Calendar\")",
            "before": [
              {
                "click": "button:has-text(\"Plan my week\")"
              },
              {
                "waitFor": ".modal p:text-is(\"What would you like to do?\")"
              }
            ],
            "settle": 800
          }
        }
      ],
      "transition": "hold"
    },
    {
      "id": "tasks-backlog",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 4.5,
      "caption": "The backlog, filtered by direction and priority.",
      "narration": "Everything unplaced lives here, ranked by priority.",
      "shots": [
        {
          "id": "tasks-backlog",
          "url": "planning.local/tasks",
          "alt": "The Tasks backlog with its tabs and priority chips.",
          "motion": "push-in",
          "capture": {
            "path": "/tasks",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Tasks\")",
            "settle": 1000
          }
        }
      ]
    },
    {
      "id": "objectives-tree",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 5,
      "caption": "Goals, projects, objectives — the tree tasks hang from.",
      "narration": "Goals, projects and objectives sit above the backlog.",
      "shots": [
        {
          "id": "objectives-tree",
          "url": "planning.local/tasks",
          "alt": "The Objectives tab: a goal, project and objective tree with progress rollups.",
          "motion": "drift-down",
          "capture": {
            "path": "/tasks?tab=objectives",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Goals · Projects · Objectives\")",
            "settle": 900
          }
        }
      ],
      "transition": "cut"
    },
    {
      "id": "priorities-hours",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 5.5,
      "caption": "168 hours a week, minus sleep. You allocate the rest.",
      "narration": "Name the hours each part of your life deserves, before the week claims them.",
      "shots": [
        {
          "id": "priorities-hours",
          "url": "planning.local/priorities",
          "alt": "The priorities wizard, step three: sleep reserved, then weekly hours per category.",
          "motion": "push-in",
          "capture": {
            "path": "/priorities",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Step 1: Current Satisfaction\")",
            "before": [
              {
                "click": "button:has-text(\"Next: Desired Focus\")"
              },
              {
                "waitFor": "h2:text-is(\"Step 2: Desired Focus\")"
              },
              {
                "click": "button:has-text(\"Next: Weekly Hours\")"
              },
              {
                "waitFor": "h2:text-is(\"Step 3: Weekly Hours Target\")"
              },
              {
                "eval": "() => { for (const el of document.querySelectorAll('div')) { if (el.scrollHeight > el.clientHeight + 20 && el.clientHeight > 100) { el.scrollTop = 0; return; } } }"
              },
              {
                "wait": 300
              }
            ],
            "settle": 900
          }
        }
      ]
    },
    {
      "id": "balance-index",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 5.5,
      "caption": "Balance Index — satisfaction against the importance you set.",
      "narration": "Balance scores how closely satisfaction tracks stated importance.",
      "shots": [
        {
          "id": "balance-index",
          "url": "planning.local/balance",
          "alt": "Life Balance: index, weekly target, satisfaction, per category.",
          "motion": "drift-down",
          "capture": {
            "path": "/balance",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Life Balance\")",
            "settle": 900
          }
        }
      ]
    },
    {
      "id": "tags-taxonomy",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 4,
      "caption": "Tags file under a direction — home, work, community.",
      "narration": "Two axes of tags: direction and intention.",
      "shots": [
        {
          "id": "tags-taxonomy",
          "url": "planning.local/tags",
          "alt": "The Tags screen: direction and intention taxonomies.",
          "motion": "push-in",
          "capture": {
            "path": "/tags",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Tags\")",
            "settle": 900
          },
          "focus": {
            "landscape": {
              "x": 0.16,
              "y": 0.16,
              "w": 0.84,
              "h": 0.42
            }
          }
        }
      ]
    },
    {
      "id": "settings-schedule-patterns",
      "kind": "screen",
      "chapter": "plan",
      "seconds": 6,
      "caption": "Work, home and community each get their own hours.",
      "narration": "Placement obeys the windows you set for work, home and community.",
      "shots": [
        {
          "id": "settings-schedule-patterns",
          "url": "planning.local/settings",
          "alt": "Settings, Preferences tab: day types and per-direction availability windows.",
          "motion": "drift-down",
          "capture": {
            "path": "/settings",
            "waitUntil": "domcontentloaded",
            "waitFor": "h1:text-is(\"Settings\")",
            "before": [
              {
                "click": "button:text-is(\"Preferences\")"
              },
              {
                "waitFor": "div.section-label:text-is(\"Schedule Patterns\")"
              }
            ],
            "settle": 900
          }
        }
      ]
    },
    {
      "id": "recap",
      "kind": "feature",
      "seconds": 5.5,
      "title": "Local by default",
      "caption": "One SQLite file on hardware you own. The model runs there too.",
      "narration": "All of it in one SQLite file on your disk, behind a local sign-in.",
      "items": [
        {
          "label": "Store",
          "value": "SQLite on your disk"
        },
        {
          "label": "Sign-in",
          "value": "Local account, no cloud sign-up"
        },
        {
          "label": "AI",
          "value": "Your Hub's Ollama, or none"
        },
        {
          "label": "Runs on",
          "value": "Companion Hub, or your laptop"
        }
      ],
      "reveal": "paced"
    },
    {
      "id": "close",
      "kind": "outro",
      "seconds": 5,
      "cta": "UnCloud your life.",
      "url": "ci.computer",
      "narration": "Companion Planning, from Companion Intelligence. UnCloud your life.",
      "mark": "brand:logo.full"
    }
  ]
