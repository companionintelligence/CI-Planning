              "w": 1,
              "h": 1
            }
          },
          "pointer": {
            "landscape": {
              "x": 0.428,
              "y": 0.176
            },
            "portrait": {
              "x": 0.368,
              "y": 0.189
            }
          },
          "capture": {
            "path": "/tasks?tab=objectives",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Goals · Projects · Objectives\")",
            "settle": 900
          }
        }
      ]
    },
    {
      "id": "the-arithmetic",
      "kind": "screen",
      "chapter": "long",
      "seconds": 7,
      "transition": "cut",
      "caption": "168 hours a week. Sleep takes 63. You allocate the 105 that are left.",
      "narration": "A week is a hundred and sixty-eight hours. Sleep takes sixty-three. You spend the rest on purpose.",
      "shots": [
        {
          "id": "priorities-hours",
          "url": "planning-living-room-server-acme.ci.computer/priorities",
          "alt": "The Life Balance wizard, step three: nine hours a night reserved as sixty-three hours a week, and a running Allocated 95h / 105h against the hours that are left.",
          "motion": "drift-down",
          "focus": {
            "landscape": {
              "x": 0.192,
              "y": 0.123,
              "w": 0.576,
              "h": 0.538
            },
            "portrait": {
              "x": 0,
              "y": 0,
              "w": 1,
              "h": 1
            }
          },
          "pointer": {
            "landscape": {
              "x": 0.551,
              "y": 0.44
            },
            "portrait": {
              "x": 0.365,
              "y": 0.546
            }
          },
          "capture": {
            "path": "/priorities",
            "waitUntil": "domcontentloaded",
            "waitFor": "h2:text-is(\"Step 1: Current Satisfaction\")",
            "before": [
              {
                "click": "button:has-text(\"Next: Desired Focus\")"
              },
              {
                "waitFor": "h2:text-is(\"Step 2: Desired Focus\")"
              },
              {
                "click": "button:has-text(\"Next: Weekly Hours\")"
              },
              {
                "waitFor": "h2:text-is(\"Step 3: Weekly Hours Target\")"
              },
              {
                "eval": "() => { for (const el of document.querySelectorAll('div')) { if (el.scrollHeight > el.clientHeight + 20 && el.clientHeight > 100) { el.scrollTop = 0; return; } } }"
              },
              {
                "wait": 300
              }
            ],
            "settle": 900
          }
        }
      ]
    },
    {
      "id": "the-dial",
