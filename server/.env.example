# Companion Planning — server environment (copy to .env; never commit real keys)

# ── Web Push / VAPID (Phase H) ───────────────────────────────────────────────
# Generate ONCE per deployment:  npx web-push generate-vapid-keys
# Rotating these invalidates every existing browser subscription (clients must
# re-subscribe). Missing keys → push disabled; in-app SSE reminders still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@companion.local

# ── Optional overrides (defaults shown) ──────────────────────────────────────
# PORT=3848
# DB_PATH=
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_SMALL=qwen2.5:0.5b
# OLLAMA_MEDIUM=gemma4:e4b
# OLLAMA_EMBED=nomic-embed-text
