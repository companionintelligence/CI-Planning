# Companion Planning — server environment
#
# Copy to `server/.env` (gitignored) and edit. NEVER commit real keys or secrets.
#
# This file documents every environment variable that configures the server (internal
# plumbing such as PATH and the MCP child's injected token is intentionally excluded).
# Uncommented lines are the ones a real deployment most commonly sets; commented lines show the built-in default and
# are safe to leave as-is (uncomment only to override).
# Anything marked REQUIRED is only required in the mode noted next to it.
#
# Authoritative reference: README.md → "Environment variables".
# Live Google setup: docs/google-cloud-setup.md.

# ── Core server ──────────────────────────────────────────────────────────────
# PORT=3848
# DB_PATH — SQLite file path. macOS defaults to
#   ~/Library/Application Support/CompanionPlanning/companion.db; Docker uses
#   /data/companion.db. MUST be set explicitly on Linux/Windows. The containing
#   directory is created automatically.
# DB_PATH=/data/companion.db
# PUBLIC_BASE_URL=http://localhost:3848   # externally reachable base URL; derives the default OAuth redirect URI
# TZ=UTC                                  # process timezone (honored by the Node runtime, not read by app code) — set to your zone so "today"/cron match your day
# LOG_LEVEL=info                          # debug | info | warn | error
# NODE_ENV=production                     # enables fail-closed boot guards (e.g. forbids AUTH_MODE=test)
# TRUST_PROXY=true                        # set when behind a trusted TLS-terminating reverse proxy (e.g. CI-Hub's
#                                         #   tunnel): honors X-Forwarded-Proto (⇒ Secure session cookies over HTTPS)
#                                         #   and X-Forwarded-For (⇒ real client IP for login rate-limiting). Default off.

# ── Auth (Phase I) ───────────────────────────────────────────────────────────
# AUTH_MODE=test              # test (dev/CI — system owner injected; FORBIDDEN when NODE_ENV=production)
#                             #   | standalone (hashed x-api-key in the api_keys table)
#                             #   | sso (JWKS-verified Bearer JWT)
# AUTH_AUTO_PROVISION=false   # true → an unknown SSO `sub` provisions a new owner row instead of 403
# AUTH_RATE_WINDOW_MS=60000   # rate-limit sliding window (ms)
# AUTH_RATE_MAX=60            # max requests per window per IP
# AUTH_RATE_ISSUE_MAX=5       # max token-issue ops (login / key exchange) per window per IP
#
# Sessions (U1/U2) — both AUTH_MODE=sso login paths end in a signed session cookie:
# SESSION_SECRET=             # Signs the httpOnly session cookie (AUTH_MODE=sso). AUTO-PROVISIONED
#                             #   when unset: generated once and persisted as `.session-secret`
#                             #   beside the database (mode 0600), then reused on every boot — so a
#                             #   container install boots without an operator inventing one.
#                             #   SET IT EXPLICITLY when you run more than one replica (all replicas
#                             #   must share one secret) or keep secrets outside the data volume.
#                             #   Generate: `openssl rand -hex 32`. Changing it signs everyone out.
#
# Local username/password login (U2) — meaningful ONLY when AUTH_MODE=sso:
# DISABLE_OIDC=false          # true → disable OIDC entirely; serve local username/password login instead.
#                             #   test/standalone modes ignore this.
# AUTH_DEFAULT_USERNAME=admin # first local owner seeded on boot if none exist yet
# AUTH_DEFAULT_PASSWORD=      # REQUIRED to seed that owner (DISABLE_OIDC=true + zero local owners) — fail-closed if unset
# AUTH_RESET_TOKEN_TTL_MS=3600000  # password-reset link lifetime (V; default 60 min, single-use)
#
# CI-Portal SSO (U1) — meaningful ONLY when AUTH_MODE=sso and DISABLE_OIDC is not true.
# Companion Planning is an OAuth 2.1 + PKCE consumer of CI-Portal (better-auth), the same
# role CI-Import Tools plays. DISCOVERY-DRIVEN: set just the issuer + client id; the
# authorize/token/JWKS endpoints (and the canonical token `iss`) are read at runtime from
# <issuer>/.well-known/openid-configuration. Reachable over Tailscale.
# CIPORTAL_ISSUER=            # discovery base. Default: https://hub.companionintelligence.com/api/auth
#                             #   (better-auth serves discovery at …/api/auth; the id_token `iss` claim is the
#                             #   bare origin — the callback validates `iss` against the discovered doc's issuer)
# CIPORTAL_CLIENT_ID=ci-planning  # default `ci-planning` — registered with CI-Portal as a first-party PUBLIC
#                             #   (PKCE, no secret) client. A fixed first-party identity, not per-deployment
#                             #   config, so it no longer has to be discovered and set by hand. Override only
#                             #   for a fixture portal or a differently-registered fork.
# CIPORTAL_CLIENT_SECRET=     # ONLY if registered as a confidential client (public/PKCE ⇒ leave unset)
# CIPORTAL_REDIRECT_URI=      # default: ${PUBLIC_BASE_URL}/api/auth/ciportal/callback — MUST match the registered URI
# CIPORTAL_MEMORY_REDIRECT_URI= # AA0b — the memory connector's OWN callback; default: ${PUBLIC_BASE_URL}/api/memory/ciportal/callback.
#                             #   MUST also be registered with CI-Portal. The connector flow adds `offline_access` to the
#                             #   scopes below and stores the refresh token so it self-refreshes the CI-Server bearer.
# CIPORTAL_SCOPES=openid profile email
#
# Advanced: set ALL THREE to bypass discovery (air-gapped / a provider with no discovery doc).
# When overriding, CIPORTAL_ISSUER must equal the token's actual `iss` claim.
# CIPORTAL_AUTHORIZE_URI=
# CIPORTAL_TOKEN_URI=
# CIPORTAL_JWKS_URI=
#
# NOTE: the CIPORTAL_* set above fully replaced the older generic AUTH_JWKS_URL /
# AUTH_ISSUER / AUTH_AUDIENCE / AUTH_CONTRACT_VERSION vars, which have been RETIRED —
# they were parsed into config but read by no code path. Setting them now does nothing
# and they are gone from config.ts, so nothing silently looks like a security control
# while enforcing nothing. The live equivalents: the JWKS endpoint and expected `iss`
# come from CIPORTAL_ISSUER discovery (origin-checked against the issuer), and the `aud`
# check uses CIPORTAL_CLIENT_ID.

# ── Email / password reset (Phase V) ─────────────────────────────────────────
# Outbound email for local-login password reset (only meaningful when AUTH_MODE=sso +
# DISABLE_OIDC=true — SSO owners reset in CI-Portal). When SMTP_HOST is UNSET the mail
# adapter falls back to a console transport that LOGS the message instead of sending it,
# so dev/CI/offline runs need no SMTP. A production local-login deploy WITHOUT SMTP boots
# with a warning (reset links would only be logged, never delivered).
# SMTP_HOST=                  # SMTP server hostname — set to enable real delivery
# SMTP_PORT=587               # 587 (STARTTLS) or 465 (implicit TLS)
# SMTP_SECURE=false           # true for port 465 (implicit TLS); false for 587/25 (STARTTLS)
# SMTP_USER=                  # SMTP auth username (omit for an unauthenticated relay)
# SMTP_PASS=                  # SMTP auth password. NEVER commit.
# MAIL_FROM=Companion Planning <no-reply@companion.local>   # From: header on reset emails
# APP_BASE_URL=               # base URL the reset link is built against; defaults to PUBLIC_BASE_URL
#                             #   (link is ${APP_BASE_URL}/reset-password?token=…) — set if the externally
#                             #   reachable URL differs from PUBLIC_BASE_URL

# ── GraphQL (Phase W) ─────────────────────────────────────────────────────────
# GraphQL is served at /api/graphql (additive to REST; behind the same auth as /api/*).
# GRAPHQL_MAX_COMPLEXITY=1000  # reject a query whose estimated cost (fields selected) exceeds this
# GRAPHQL_SANDBOX=1            # W-sandbox: self-hosted, vendored GraphiQL IDE at GET
#                               #   /api/graphql/sandbox (auth-gated same as everything under
#                               #   /api/*; zero external requests — see graphql/sandbox.ts).
#                               #   On by default outside production; in production it's
#                               #   OPT-IN — set GRAPHQL_SANDBOX=1 to enable it there too.
#                               #   Unset/any other value in production ⇒ route 404s.

# ── Token encryption / KEK (Phase J) ─────────────────────────────────────────
# CP_KEK_B64 — base64 of a 32-byte AES-256-GCM key-encryption key sealing the
#   connection_tokens store. Generate: openssl rand -base64 32
#   REQUIRED for live Google token storage/refresh (loaded lazily → the first token
#   operation fails if it is unset, not boot). NEVER commit.
# CP_KEK_B64=
# CP_KEK_VERSION=1            # version a fresh seal is written under (drives rotation)
# CP_KEK_B64_V2=              # historical KEK while rotating (CP_KEK_B64_V{n} per past version)

# ── Google connector (Phase J) ───────────────────────────────────────────────
# Unset (the default) = Google integration OFF — unless an admin saves a Google OAuth
# client in Settings → Connections (in-app setup; needs CP_KEK_B64), which flips live
# mode on at runtime. An explicit GOOGLE_MODE here pins the mode and makes the in-app
# setup read-only. Users connect their own account in Settings → Connections in live mode.
# GOOGLE_MODE=fixture is a dev/demo opt-in: fully offline on committed sample data
# that LOOKS like real emails/events (refused in production unless CP_ALLOW_FIXTURE=true).
# GOOGLE_MODE=live            # live = real Google OAuth + Calendar sync (requires the vars below); fixture = offline sample data
# CP_ALLOW_FIXTURE=false      # true allows GOOGLE_MODE=fixture under NODE_ENV=production (demo appliances only)
# CP_GOOGLE_CLIENT_ID=        # REQUIRED when GOOGLE_MODE=live
# CP_GOOGLE_CLIENT_SECRET=    # needed for a Web client (ts.net HTTPS deploy); a Desktop/loopback client can omit it. NEVER commit.
# CP_OAUTH_REDIRECT_URI=      # default: ${PUBLIC_BASE_URL}/api/oauth/google/callback — MUST match the URI registered in Google
# CP_GOOGLE_ENABLE_GMAIL=false  # true also requests the Gmail (restricted) scope on /start
# CP_GOOGLE_ACCOUNT=primary   # account key the live client binds its MCP session to
# --- OAuth/JWKS endpoints (override only to point tests at a stub) ---
# CP_GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
# CP_GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
# CP_GOOGLE_REVOKE_URI=https://oauth2.googleapis.com/revoke
# CP_GOOGLE_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs   # verifies the id_token signature at the callback

# ── MCP transport (Google connector child) ───────────────────────────────────
# CP_MCP_COMMAND — command that launches the Calendar MCP child driven over stdio.
#   REQUIRED for GOOGLE_MODE=live (unset ⇒ live sync fails with McpUnavailable).
#   CP ships one (run from server/): node_modules/.bin/tsx src/scripts/mcp-google-server.ts
# CP_MCP_COMMAND=
# CP_MCP_TIMEOUT_MS=30000     # per-call timeout for MCP requests
# CP_MCP_RETRIES=3            # retry budget per MCP request
# CP_MCP_BREAKER_THRESHOLD=5  # consecutive MCP failures before the circuit breaker opens
# CP_MCP_BREAKER_COOLDOWN_MS=30000  # how long the breaker stays open before it half-opens

# ── Sync engine (Phase J) ────────────────────────────────────────────────────
# CP_SYNC_WRITEBACK=false     # true → push local block changes back to the provider (default: inbound read-only)
# CP_SYNC_DISABLED=false      # true → master kill switch: disables the sync agent entirely (inbound reconcile + outbound queueing/push/deletes)

# ── Postgres (schema port) ───────────────────────────────────────────────────
# The store is moving from SQLite to Postgres with CI-Server's stack (TypeORM +
# dbmate + pgvector). UNSET ⇒ the SQLite store at DB_PATH is used, which is still the
# default — both backends coexist while call sites migrate. See server/db/postgres/README.md.
#
# `planning` is a SCHEMA, so this can point at the same database as CI-Server's `ci.*`.
# DATABASE_URL=postgres://planning:pw@localhost:5432/planning
# POSTGRES_PASSWORD=          # docker-compose only: required when running the bundled postgres
# POSTGRES_USER=planning      # docker-compose only
# POSTGRES_DB=planning        # docker-compose only
# TYPEORM_LOGGING=false       # true ⇒ log every ORM-issued statement

# ── CI-Server companion-memory (Phase AA) ────────────────────────────────────
# Pull-side connector for the CI-Server memory graph (Settings → Companion Memory).
# Per-owner creds connected in Settings (KEK-encrypted in connection_tokens) take
# precedence; the env pair below is a dev/single-tenant convenience fallback only.
# SINGLE-TENANT ONLY: under multi-tenant SSO (AUTH_MODE=sso without DISABLE_OIDC) the
# env pair is IGNORED — CI-Server derives the user from the API key, so a shared env
# key would map every owner to ONE CI-Server identity; owners connect in Settings.
# The memory_suggest job + suggestion surfaces additionally require the per-owner
# memory_pull_enabled Setting (default off).
# MEMORY_MODE=live            # unset (default) = memory transport OFF; live = call the real CI-Server API; fixture = dev/demo opt-in reading server/fixtures/memory/graph.json
# CI_SERVER_URL=              # e.g. http://localhost:3000 — CI-Server memory API base URL. Used as env-fallback creds
#                             #   (single-tenant only, paired with CI_SERVER_API_KEY) AND as the API base for the AA0b
#                             #   CI-Portal SSO connection (multi-tenant-safe there: the bearer is per-user).
# CI_SERVER_API_KEY=          # sent as x-api-key (may coexist with a Bearer token). Single-tenant only. NEVER commit.
# CP_MEMORY_FIXTURES_DIR=     # override the memory fixture dir (server/fixtures/memory) — tests only

# ── Ollama (optional local LLM) ──────────────────────────────────────────────
# AI features need the Ollama server running (`ollama serve`, or the desktop app)
# AND the models below pulled. The defaults are real, pullable tags — if you have
# different models, set these to any name shown by `ollama list`. A model that is
# configured but not pulled fails with an actionable "run `ollama pull …`" error.
#   ollama pull qwen2.5:0.5b && ollama pull gemma3n:e4b && ollama pull nomic-embed-text
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_SMALL=qwen2.5:0.5b
# OLLAMA_MEDIUM=gemma3n:e4b
# OLLAMA_EMBED=nomic-embed-text

# ── Web Push / VAPID (Phase H) ───────────────────────────────────────────────
# Leave these UNSET for the normal case: the server auto-generates a VAPID keypair
# on first boot and persists it to app_config (sealed with CP_KEK_B64 when set, else
# stored unsealed), so push works out of the box and stays stable across restarts.
# Set BOTH to pin an explicit keypair instead (a lone half keeps push dormant).
# Rotating a pinned keypair invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: contact address push services email on delivery problems. Leave unset to let
# the server prefer the first operator owner's email (default: mailto:admin@companion.local).
# VAPID_SUBJECT=mailto:admin@companion.local

# ── Backups ──────────────────────────────────────────────────────────────────
# SNAPSHOT_RETAIN=7           # daily snapshots kept in <DB_DIR>/backups/

# ── Error reporting / Sentry (OPTIONAL — off by default) ─────────────────────
# Opt-in: with SENTRY_DSN unset nothing initialises and the process makes NO outbound
# connection to Sentry. Errors only — no tracing, no session replay, no PII
# (sendDefaultPii=false) — and every payload is scrubbed of credentials and home paths
# before it leaves. Full posture: docs/operations/error-reporting.md.
# SENTRY_DSN=                 # https://<key>@o<org>.ingest.us.sentry.io/<id> — enables reporting
# SENTRY_ENV=                 # Sentry `environment`; falls back to CI_PLANNING_ENVIRONMENT, then NODE_ENV, then "development"
# CI_PLANNING_ENVIRONMENT=    # second choice for `environment` (fleet-wide convention)
# CI_PLANNING_VERSION=        # derives `release` as ci-planning-server@<version>
# SENTRY_RELEASE=             # explicit release string; wins over the derived one
#
# Kill switches — BOTH beat a configured DSN, so an operator can disable reporting that
# was baked into an image without rebuilding it. Precedence: CI_LOCAL_ONLY > CI_TELEMETRY.
# They govern the BROWSER as well: its DSN is baked in at build time and cannot see
# these, so the bundle asks the server (GET /api/config/telemetry, unauthenticated) for
# the verdict before it initialises, and stays off if it can't get one.
# CI_TELEMETRY=off            # off | false | 0 | no | disabled (case-insensitive)
# CI_LOCAL_ONLY=true          # true | 1 | yes | on — local-only mode means zero phone-home
#
# The browser's own DSN/release/environment are BUILD-time values (VITE_SENTRY_DSN,
# VITE_SENTRY_RELEASE, VITE_CI_PLANNING_ENVIRONMENT): Vite inlines them into the bundle,
# so setting them here does nothing. In Docker they are build args — see the Dockerfile.

# ── Test / fixtures (dev only) ───────────────────────────────────────────────
# CP_FIXTURES_DIR=            # override the committed Google fixture data dir (server/test/fixtures) — tests only
#
# Fixture CI-Portal (U1) — a standalone dev OIDC provider for exercising the real
# /api/auth/ciportal/* login flow WITHOUT the real CI-Portal. Never part of the app.
# Run:  pnpm --filter server exec tsx src/scripts/fixture-portal.ts
# These configure only that script (see its header for the matching CIPORTAL_* to set):
# FIXTURE_PORTAL_PORT=9899                 # port the fixture provider listens on
# FIXTURE_PORTAL_ISSUER=                   # issuer it advertises; default http://localhost:${FIXTURE_PORTAL_PORT}
# FIXTURE_SUB=fixture-user-001             # `sub` claim minted into the fixture id_token
# FIXTURE_NAME=Avery Fixture               # `name` claim
# FIXTURE_EMAIL=avery@fixture.local        # `email` claim
