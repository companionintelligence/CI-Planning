{
  "name": "server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/scripts/seed-test-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "migrate": "tsx src/scripts/migrate.ts",
    "snapshot": "tsx src/scripts/snapshot.ts",
    "restore": "tsx src/scripts/restore.ts",
    "key:issue": "tsx src/cli/issue-key.ts"
  },
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.6.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.10.0",
    "chrono-node": "^2.9.1",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.2",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "rrule": "^2.8.1",
    "sqlite-vec": "^0.1.9",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-static": "^4.0.4",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^25.9.2",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
