# Copy to mcp.local.env and keep that file local (it is gitignored).
CP_MCP_APP_URL=http://127.0.0.1:3848

# For AUTH_MODE=sso with local login enabled, use a dedicated local account.
CP_MCP_APP_USERNAME=
CP_MCP_APP_PASSWORD=

# Alternative for AUTH_MODE=standalone. Do not use this in AUTH_MODE=sso.
CP_MCP_APP_API_KEY=
