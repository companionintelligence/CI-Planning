    API_KEYS {
        string id PK
        string owner_id FK
        string prefix
        string key_hash
        string scopes
        string expires_at
        string last_used_at
        string created_at
        string revoked_at
    }

    AUDIT_LOG {
        string id PK
        string owner_id FK
        string actor
        string action
        string entity
        string at
    }

    BLOCK_TEMPLATES {
        string id PK
        string owner_id FK
        string name
        string tag
        int default_minutes
        string tasks
    }

    CATEGORY_DIRECTION_OPTOUTS {
        string category_tag_id PK,FK
        string pattern_tag_id PK,FK
    }

