{
  "name": "companion-planning",
  "version": "4.2.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter client build",
    "start": "pnpm build && pnpm --filter server start",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter client typecheck",
    "typecheck:server": "pnpm --filter server typecheck",
    "typecheck:client": "pnpm --filter client typecheck",
    "test": "pnpm --filter server test && pnpm --filter client test",
    "test:server": "pnpm --filter server test",
    "test:client": "pnpm --filter client test",
    "seed": "pnpm --filter server seed",
    "db:generate": "pnpm --filter server db:generate",
    "db:migrate": "pnpm --filter server db:migrate",
    "migrate": "pnpm --filter server migrate",
    "lint:canon": "ci-lint-canon ."
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "@companionintelligence/config": "^1.0.0"
  }
}
