{
  "name": "companion-planning",
  "version": "1.0.0",
  "description": "Static web app for viewing and checking off markdown todos",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:ts": "node server/dist/index.js --host 0.0.0.0",
    "dev:ts": "node_modules/.bin/tsx watch server/src/index.ts -- --host 0.0.0.0",
    "build": "node_modules/.bin/tsc",
    "typecheck": "node_modules/.bin/tsc --noEmit",
    "mcp:ts": "node server/dist/mcp-stdio.js",
    "test": "node_modules/.bin/vitest run",
    "test:watch": "node_modules/.bin/vitest",
    "test:legacy": "node --test test/*.test.js"
  },
  "keywords": [
    "markdown",
    "todo",
    "checkbox",
    "planning",
    "static"
  ],
  "author": "Liam Broza <liam.broza@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrhegemon/companion-planning.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "chokidar": "^3.6.0",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.0",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
