node_modules/
.DS_Store
*.log
dist/
server/public/
server/dist/
*.db
*.db-shm
*.db-wal
# Auto-provisioned session-cookie signing key (lib/config.ts). Lives beside the DB, so
# it lands in the repo whenever a dev points DB_PATH at a working directory here.
.session-secret
.env
# Sibling env files for extra local instances (e.g. .env.ssotest). `.env` alone does
# not match them, so one could otherwise be committed by accident.
.env.*
!.env.example
config.local.json
*.plist
# ...except the iOS shell's own: Info.plist and the Xcode workspace files are source, and the
# app does not build without them (mobile/ios).
!mobile/ios/**/*.plist
.codex/
# The local data dir. `.data/` below has never matched anything — the app's actual
# default is `data/`: local dev points DB_PATH at ./data/companion.db, and the container
# uses /data/companion.db (Dockerfile). The *.db rules above already cover the databases
# themselves, so this is what keeps the directory's OTHER contents — WAL/shm leftovers,
# fuse strays from interrupted writes — out of `git status` permanently.
data/
.data/
test-results/
playwright-report/
playwright/.cache/

# Local design notes kept in the working tree but deliberately not in the repo: the G-phase
# circles/rituals exploration and its stress test, the technical-diagram dump (diagrams.html
# is ~3MB of generated output) and the colour-system gap analysis. Untracked since June 2026
# by choice — listed here so they stop appearing in `git status` and can't be swept into a
# commit by a stray `git add .`. Listed individually rather than as `docs/G-*.md` so a future
# doc that IS meant to be tracked isn't silently ignored.
docs/DIAGRAMS.md
docs/diagrams.html
docs/G-circles-stress-test.md
docs/G-rituals-circles-design.md
docs/G-updated-plan.md
docs/styleguide-color-gap-analysis.md

# The container smoke harness installs its own deps (docker-publish.yml runs npm install there).
tests/container/node_modules/
