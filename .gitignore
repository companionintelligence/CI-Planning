node_modules/
.DS_Store
*.log
dist/
server/public/
server/dist/
*.db
*.db-shm
*.db-wal
# Auto-provisioned session-cookie signing key (lib/config.ts). Lives beside the DB, so
# it lands in the repo whenever a dev points DB_PATH at a working directory here.
.session-secret
.env
# Sibling env files for extra local instances (e.g. .env.ssotest). `.env` alone does
# not match them, so one could otherwise be committed by accident.
.env.*
!.env.example
config.local.json
*.plist
.codex/
# The local data dir. `.data/` below has never matched anything — the app's actual
# default is `data/`: local dev points DB_PATH at ./data/companion.db, and the container
# uses /data/companion.db (Dockerfile). The *.db rules above already cover the databases
# themselves, so this is what keeps the directory's OTHER contents — WAL/shm leftovers,
# fuse strays from interrupted writes — out of `git status` permanently.
data/
.data/
test-results/
playwright-report/
playwright/.cache/
